# copy to .env — never commit .env
IQAMA_OCR_PROVIDER=easyocr        # paddle (primary, production) | easyocr | mock
IQAMA_ENC_KEY=                    # python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
IQAMA_API_KEY=                    # required header X-API-Key when set
IQAMA_WORKERS=2
IQAMA_DATA_DIR=./data
IQAMA_LOG_LEVEL=INFO
